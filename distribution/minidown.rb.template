# Homebrew Cask for minidown.
#
# Generated by .github/workflows/release.yml on each tagged release and committed to the tap at
# github.com/asitkhanda/homebrew-minidown — do not edit the copy in the tap by hand.
cask "minidown" do
  version "{{VERSION}}"
  sha256 "{{SHA256}}"

  url "https://github.com/asitkhanda/minidown/releases/download/v#{version}/minidown-#{version}.zip"
  name "minidown"
  desc "Minimal, distraction-free Markdown writer"
  homepage "https://github.com/asitkhanda/minidown"

  # Tells `brew outdated` / `brew upgrade` where to look for new versions.
  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :sonoma"

  app "Minidown.app"

  # Everything the sandboxed app writes, so `brew uninstall --zap` leaves nothing behind.
  zap trash: [
    "~/Library/Containers/io.humanx.minidown",
    "~/Library/Application Scripts/io.humanx.minidown",
    "~/Library/Saved Application State/io.humanx.minidown.savedState",
  ]
end
